{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeoKeel",
  "version": "0.1.0",
  "identifier": "dev.zeokeel.demo",
  "build": {
    "frontendDist": "web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZeoKeel",
        "width": 900,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
