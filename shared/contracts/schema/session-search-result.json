{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionSearchResult",
  "description": "`session.search` result.",
  "type": "object",
  "required": [
    "items",
    "truncated"
  ],
  "properties": {
    "items": {
      "description": "Hits in store order (pinned first, then newest).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SessionSearchHit"
      }
    },
    "truncated": {
      "description": "More hits existed than the effective limit.",
      "type": "boolean"
    }
  },
  "definitions": {
    "SessionSearchHit": {
      "description": "One session full-text search hit (snippet, not full content).",
      "type": "object",
      "required": [
        "archived",
        "conversation_id",
        "message_id",
        "role",
        "snippet",
        "title"
      ],
      "properties": {
        "archived": {
          "description": "Conversation is archived (shown with a marker, still openable).",
          "type": "boolean"
        },
        "conversation_id": {
          "description": "Conversation id.",
          "type": "string"
        },
        "message_id": {
          "description": "Matched message id.",
          "type": "string"
        },
        "role": {
          "description": "Message role (`user`/`assistant`/`tool`/`system`).",
          "type": "string"
        },
        "snippet": {
          "description": "Context window around the match (±60 chars).",
          "type": "string"
        },
        "title": {
          "description": "Conversation title.",
          "type": "string"
        }
      }
    }
  }
}
