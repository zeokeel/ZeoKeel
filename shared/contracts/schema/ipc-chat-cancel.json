{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatCancelPayload",
  "description": "`chat.cancel` payload (per-stream cancellation).",
  "type": "object",
  "required": [
    "stream_id",
    "workspace_id"
  ],
  "properties": {
    "stream_id": {
      "description": "Active stream id to cancel.",
      "type": "string"
    },
    "workspace_id": {
      "description": "Owning workspace id.",
      "type": "string"
    }
  }
}
