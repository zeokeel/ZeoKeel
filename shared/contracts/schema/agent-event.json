{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentEvent",
  "description": "Streaming events emitted during one agent turn.",
  "oneOf": [
    {
      "description": "Turn accepted and started.",
      "type": "object",
      "required": [
        "turn_id",
        "type"
      ],
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "turn_started"
          ]
        }
      }
    },
    {
      "description": "Incremental assistant text.",
      "type": "object",
      "required": [
        "delta",
        "type"
      ],
      "properties": {
        "delta": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "text_delta"
          ]
        }
      }
    },
    {
      "description": "A tool call is about to run.",
      "type": "object",
      "required": [
        "args",
        "name",
        "type"
      ],
      "properties": {
        "args": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_started"
          ]
        }
      }
    },
    {
      "description": "A tool call finished (success or error text in `result`).",
      "type": "object",
      "required": [
        "name",
        "result",
        "type"
      ],
      "properties": {
        "args": {
          "description": "Redacted JSON arguments; empty for legacy events.",
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "status": {
          "description": "Terminal tool status; legacy events default to `success`.",
          "default": "success",
          "allOf": [
            {
              "$ref": "#/definitions/ToolCallStatus"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "tool_call_finished"
          ]
        }
      }
    },
    {
      "description": "The turn needs a user approval decision.",
      "type": "object",
      "required": [
        "approval_id",
        "args",
        "reason",
        "tool",
        "type"
      ],
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "args": {
          "type": "string"
        },
        "auto": {
          "description": "`true` for the always-allow auto-approval pair (no blocking).",
          "default": false,
          "type": "boolean"
        },
        "deadline_ms": {
          "description": "Absolute deadline (ms since epoch); `0` for legacy events.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "metadata": {
          "description": "Tool-declared impact surface; `None` when the tool does not declare one.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ApprovalMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "approval_requested"
          ]
        }
      }
    },
    {
      "description": "An approval request was resolved (UI may render the outcome).",
      "type": "object",
      "required": [
        "approval_id",
        "decision",
        "type"
      ],
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/definitions/ApprovalDecision"
        },
        "timed_out": {
          "description": "`true` when the resolution is the fail-closed deadline (timeout).",
          "default": false,
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "approval_resolved"
          ]
        }
      }
    },
    {
      "description": "The agent asks the user questions and pauses until answered.",
      "type": "object",
      "required": [
        "question_id",
        "questions",
        "type"
      ],
      "properties": {
        "question_id": {
          "type": "string"
        },
        "questions": {
          "description": "Wire stays an opaque JSON value (backward compatible); the generated schema is the typed `Vec<QuestionDef>` shape for C10/T22 validation.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuestionDef"
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "question_asked"
          ]
        }
      }
    },
    {
      "description": "Questions were answered (or timed out with `null`).",
      "type": "object",
      "required": [
        "answers",
        "question_id",
        "type"
      ],
      "properties": {
        "answers": true,
        "question_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "question_answered"
          ]
        }
      }
    },
    {
      "description": "Provider token usage for the turn, emitted once before the terminal event (`TurnCompleted`/`TurnCancelled`) when the provider reported usage.\n\nAdditive event (B7): consumers that ignore unknown variants keep working; `TurnCompleted.reply.usage` remains populated for backward compatibility.",
      "type": "object",
      "required": [
        "type",
        "usage"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "usage"
          ]
        },
        "usage": {
          "$ref": "#/definitions/AgentUsage"
        }
      }
    },
    {
      "description": "Turn finished successfully.",
      "type": "object",
      "required": [
        "reply",
        "type"
      ],
      "properties": {
        "reply": {
          "$ref": "#/definitions/AgentReply"
        },
        "type": {
          "type": "string",
          "enum": [
            "turn_completed"
          ]
        }
      }
    },
    {
      "description": "Turn was cancelled by the user.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "turn_cancelled"
          ]
        }
      }
    },
    {
      "description": "Turn failed.",
      "type": "object",
      "required": [
        "message",
        "type"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "error"
          ]
        }
      }
    }
  ],
  "definitions": {
    "AgentReply": {
      "description": "Result of one agent turn.",
      "type": "object",
      "required": [
        "text",
        "tool_calls"
      ],
      "properties": {
        "text": {
          "description": "Final assistant text.",
          "type": "string"
        },
        "tool_calls": {
          "description": "Tool calls executed during the turn (empty when none).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolCallRecord"
          }
        },
        "usage": {
          "description": "Provider token usage for the turn, when reported.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/AgentUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentUsage": {
      "description": "Token usage reported by the provider for one agent turn.\n\nThe counters are required (a `usage` object is only present when the provider reported usage; unreported counters are normalized to `0` by the runtime), matching `specs/changes/2026-10-31-config-and-media/spec.md`. `cost_micros` stays optional because most providers do not report cost.",
      "type": "object",
      "required": [
        "cached_tokens",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "cached_tokens": {
          "description": "The part of `input_tokens` read from a provider-managed cache.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cost_micros": {
          "description": "Provider-reported cost in micro-USD (1e-6 USD), when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "description": "Every input token (cached + uncached).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "description": "Every output token, reasoning included.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "reasoning_tokens": {
          "description": "The part of `output_tokens` spent on internal reasoning.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "total_tokens": {
          "description": "`input_tokens + output_tokens`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "ApprovalDecision": {
      "description": "User decision for one approval request.\n\nDefined in the tool contract because [`ApprovalGate`] returns it; the agent contract re-exports it to keep `zk_contract_agent::ApprovalDecision` working.",
      "oneOf": [
        {
          "description": "Allow exactly this call.",
          "type": "string",
          "enum": [
            "allow_once"
          ]
        },
        {
          "description": "Allow this tool for the rest of the conversation (memory only).",
          "type": "string",
          "enum": [
            "allow_session"
          ]
        },
        {
          "description": "Reject this call (fail-closed default).",
          "type": "string",
          "enum": [
            "reject"
          ]
        },
        {
          "description": "Cancel the whole turn.",
          "type": "string",
          "enum": [
            "cancel"
          ]
        }
      ]
    },
    "ApprovalMetadata": {
      "description": "One approval request's declared impact surface (tool-side only).\n\nThe tool that requires approval declares this via [`Tool::approval_metadata`]; the agent runtime only aggregates it. All fields are `#[serde(default)]` so older consumers can ignore the struct.",
      "type": "object",
      "properties": {
        "cwd": {
          "description": "Absolute working directory of the call.",
          "default": "",
          "type": "string"
        },
        "diff": {
          "description": "Optional unified diff for write tools (tool-side, bounded by the tool).",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "network_targets": {
          "description": "Network targets as `host[:port]` or `<mcp:server-id>`.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network_undetermined": {
          "description": "`true` when the tool cannot statically determine its network targets (e.g. a free-form shell command).",
          "default": false,
          "type": "boolean"
        },
        "read_paths": {
          "description": "Paths the call will read (workspace-relative when possible).",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "description": "Risk level declared by the tool.",
          "default": "medium",
          "allOf": [
            {
              "$ref": "#/definitions/ApprovalRisk"
            }
          ]
        },
        "summary": {
          "description": "One-line action summary, e.g. `\"write notes.txt\"`.",
          "default": "",
          "type": "string"
        },
        "write_paths": {
          "description": "Paths the call will write (workspace-relative when possible).",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ApprovalRisk": {
      "description": "Closed risk level for one approval card.",
      "oneOf": [
        {
          "description": "Read-only or trivially reversible action.",
          "type": "string",
          "enum": [
            "low"
          ]
        },
        {
          "description": "Mutates workspace state.",
          "type": "string",
          "enum": [
            "medium"
          ]
        },
        {
          "description": "Shell / network / external side effects.",
          "type": "string",
          "enum": [
            "high"
          ]
        }
      ]
    },
    "QuestionDef": {
      "description": "One question the agent asks before continuing (`ask_user_question` tool input).\n\nMirrors the tool's argument schema: `id`/`question` are required; `header`, `options`, `multi_select` are optional and default to empty/false.",
      "type": "object",
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "header": {
          "description": "Optional short header/category.",
          "default": "",
          "type": "string"
        },
        "id": {
          "description": "Stable question id (key in the answers map).",
          "type": "string"
        },
        "multi_select": {
          "description": "Whether multiple options may be selected.",
          "default": false,
          "type": "boolean"
        },
        "options": {
          "description": "Selectable options (empty for free-text questions).",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuestionOption"
          }
        },
        "question": {
          "description": "Question text.",
          "type": "string"
        }
      }
    },
    "QuestionOption": {
      "description": "One selectable option of a user question (`ask_user_question` tool input).",
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "description": {
          "description": "Optional secondary description shown under the label.",
          "default": "",
          "type": "string"
        },
        "label": {
          "description": "Option label (the selected answer value).",
          "type": "string"
        }
      }
    },
    "ToolCallRecord": {
      "description": "One executed tool call, recorded for UI and diagnostics.",
      "type": "object",
      "required": [
        "args",
        "name",
        "result"
      ],
      "properties": {
        "args": {
          "description": "Raw arguments passed to the tool.",
          "type": "string"
        },
        "name": {
          "description": "Tool name, e.g. `fs.read`.",
          "type": "string"
        },
        "result": {
          "description": "Tool output (or error text).",
          "type": "string"
        }
      }
    },
    "ToolCallStatus": {
      "description": "Terminal status of one tool call (persisted with the tool row).",
      "oneOf": [
        {
          "description": "The tool completed successfully.",
          "type": "string",
          "enum": [
            "success"
          ]
        },
        {
          "description": "The tool ran and failed.",
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        {
          "description": "The approval policy / user denied the call (tool did not run).",
          "type": "string",
          "enum": [
            "denied"
          ]
        },
        {
          "description": "The turn was cancelled before or after the tool produced a result.",
          "type": "string",
          "enum": [
            "cancelled"
          ]
        }
      ]
    }
  }
}
