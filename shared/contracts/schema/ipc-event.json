{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UiEvent",
  "description": "Streaming event envelope. `kind` must be a stable string (e.g. `agent`).",
  "type": "object",
  "required": [
    "kind",
    "payload",
    "seq",
    "stream_id"
  ],
  "properties": {
    "kind": {
      "description": "Event kind, e.g. `agent`.",
      "type": "string"
    },
    "payload": {
      "description": "Event payload."
    },
    "seq": {
      "description": "Monotonic per stream.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "stream_id": {
      "description": "Stream id (one per turn/window).",
      "type": "string"
    }
  }
}
