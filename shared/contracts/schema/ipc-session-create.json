{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionCreatePayload",
  "description": "`session.create` payload.",
  "type": "object",
  "required": [
    "workspace_id"
  ],
  "properties": {
    "title": {
      "description": "Optional conversation title.",
      "default": "",
      "type": "string"
    },
    "workspace_id": {
      "description": "Owning workspace id (mandatory; sessions never auto-create).",
      "type": "string"
    }
  }
}
