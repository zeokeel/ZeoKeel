{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActivityJob",
  "description": "One background job row (`zk-kit-jobs` snapshot, current workspace only).",
  "type": "object",
  "required": [
    "command",
    "cwd",
    "id",
    "output_excerpt",
    "started_ms",
    "status"
  ],
  "properties": {
    "command": {
      "description": "Original command line.",
      "type": "string"
    },
    "cwd": {
      "description": "Working directory (absolute; filtered to the current workspace root).",
      "type": "string"
    },
    "id": {
      "description": "Job id (`job-N`).",
      "type": "string"
    },
    "output_excerpt": {
      "description": "stdout+stderr excerpt (≤4 KiB, truncated on a char boundary).",
      "type": "string"
    },
    "started_ms": {
      "description": "Start time (ms since epoch).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "status": {
      "description": "`running` | `completed` | `failed:<code>` (kernel-reported).",
      "type": "string"
    }
  }
}
