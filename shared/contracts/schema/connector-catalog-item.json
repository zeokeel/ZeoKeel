{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectorCatalogItem",
  "description": "One client connector catalog item (`GET /api/client/v1/connectors`, extended with `config`).",
  "type": "object",
  "required": [
    "id",
    "name",
    "transport"
  ],
  "properties": {
    "config": {
      "default": {
        "command": "",
        "args": [],
        "env": {},
        "url": "",
        "timeout_ms": 0
      },
      "allOf": [
        {
          "$ref": "#/definitions/ConnectorConfig"
        }
      ]
    },
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "oauth": {
      "description": "OAuth public-client metadata (no secret); absent for non-OAuth connectors.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/ConnectorOAuth"
        },
        {
          "type": "null"
        }
      ]
    },
    "transport": {
      "$ref": "#/definitions/ConnectorTransport"
    }
  },
  "definitions": {
    "ConnectorConfig": {
      "description": "Non-secret connector execution config delivered to clients (ADR-060).",
      "type": "object",
      "properties": {
        "args": {
          "description": "Verbatim argv for stdio.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "Executable for stdio (no shell; args verbatim).",
          "default": "",
          "type": "string"
        },
        "env": {
          "description": "Allow-listed child environment (no static secrets).",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_ms": {
          "description": "Per-request timeout (ms; 0/absent => client default).",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "url": {
          "description": "HTTP(S) endpoint for http/sse transports.",
          "default": "",
          "type": "string"
        }
      }
    },
    "ConnectorOAuth": {
      "description": "OAuth public-client metadata (no client_secret; ADR-060, docs/07 §6).\n\nThe desktop client runs the authorization-code + PKCE flow itself: it opens the system browser at [`authorize_url`](Self::authorize_url), listens on an ephemeral loopback redirect (RFC 8252), then exchanges the code at [`token_url`](Self::token_url). Tokens stay in the client keychain; the server only stores this non-secret metadata.",
      "type": "object",
      "required": [
        "client_id",
        "redirect_uri"
      ],
      "properties": {
        "authorize_url": {
          "description": "OAuth authorize endpoint (non-secret; catalog `config.authorize_url`).",
          "default": "",
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "redirect_uri": {
          "type": "string"
        },
        "scopes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_url": {
          "description": "OAuth token endpoint (non-secret; catalog `config.token_url`).",
          "default": "",
          "type": "string"
        }
      }
    },
    "ConnectorTransport": {
      "description": "MCP transport.",
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    }
  }
}
