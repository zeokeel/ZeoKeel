{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppSettings",
  "description": "App settings persisted locally.",
  "type": "object",
  "required": [
    "auto_approve_read_only",
    "locale",
    "provider",
    "schema",
    "theme"
  ],
  "properties": {
    "agent": {
      "description": "Runtime-configurable local agent settings (backward compatible default).",
      "default": {
        "max_steps": 50,
        "completion": {
          "temperature": null,
          "max_tokens": null,
          "top_p": null,
          "seed": null,
          "stop": [],
          "tool_choice": {
            "mode": "auto"
          },
          "parallel_tool_calls": null,
          "reasoning_effort": null,
          "prompt_cache": null
        },
        "memory": {
          "enabled": true,
          "dir": ""
        },
        "hooks": {
          "enabled": true,
          "log": ""
        },
        "schedule": {
          "enabled": false,
          "scan_seconds": 10
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/AgentSettings"
        }
      ]
    },
    "auto_approve_read_only": {
      "description": "Auto-approve read-only tools (M1 default true for fs.read).",
      "type": "boolean"
    },
    "embedding": {
      "description": "Personal-edition embedding/vector provider (backward compatible default).",
      "default": {
        "base_url": "",
        "api_key": "",
        "model": "",
        "dims": null,
        "dir": ""
      },
      "allOf": [
        {
          "$ref": "#/definitions/EmbeddingSettings"
        }
      ]
    },
    "locale": {
      "description": "Locale: `zh-CN` | `en-US`.",
      "type": "string"
    },
    "mcp": {
      "description": "Local MCP servers (personal edition; backward compatible default).",
      "default": {
        "servers": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/McpSettings"
        }
      ]
    },
    "media": {
      "description": "Personal-edition media capabilities (backward compatible default).",
      "default": {
        "base_url": "",
        "api_key": "",
        "image_model": "",
        "audio_model": "",
        "transcription_model": "",
        "rerank_model": ""
      },
      "allOf": [
        {
          "$ref": "#/definitions/MediaSettings"
        }
      ]
    },
    "provider": {
      "description": "Provider config.",
      "allOf": [
        {
          "$ref": "#/definitions/ProviderConfig"
        }
      ]
    },
    "schema": {
      "description": "Schema version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "server_url": {
      "description": "Enterprise login server URL (personal edition: empty).",
      "default": "",
      "type": "string"
    },
    "theme": {
      "description": "Theme: `auto` | `light` | `dark`.",
      "type": "string"
    },
    "tools": {
      "description": "Tool execution / approval timeouts (backward compatible default).",
      "default": {
        "tool_timeout_ms": 120000,
        "approval_timeout_ms": 300000,
        "approval_policy": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/ToolSettings"
        }
      ]
    },
    "web_search": {
      "description": "Web-search tool endpoint settings (backward compatible default).",
      "default": {
        "base_url": "",
        "timeout_ms": 15000
      },
      "allOf": [
        {
          "$ref": "#/definitions/WebSearchSettings"
        }
      ]
    }
  },
  "definitions": {
    "AgentSettings": {
      "description": "Runtime-configurable local agent settings.",
      "type": "object",
      "properties": {
        "completion": {
          "description": "Sampling / generation parameters.",
          "default": {
            "temperature": null,
            "max_tokens": null,
            "top_p": null,
            "seed": null,
            "stop": [],
            "tool_choice": {
              "mode": "auto"
            },
            "parallel_tool_calls": null,
            "reasoning_effort": null,
            "prompt_cache": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/CompletionSettings"
            }
          ]
        },
        "hooks": {
          "description": "Observable lifecycle hooks.",
          "default": {
            "enabled": true,
            "log": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/HookSettings"
            }
          ]
        },
        "max_steps": {
          "description": "Maximum model/tool steps per turn (`1..=200`; default 50).",
          "default": 50,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "memory": {
          "description": "Multi-turn conversation memory.",
          "default": {
            "enabled": true,
            "dir": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/MemorySettings"
            }
          ]
        },
        "schedule": {
          "description": "Workspace schedule auto-run (disabled by default).",
          "default": {
            "enabled": false,
            "scan_seconds": 10
          },
          "allOf": [
            {
              "$ref": "#/definitions/ScheduleSettings"
            }
          ]
        }
      }
    },
    "ApprovalPolicy": {
      "description": "Closed local approval policy for tool calls (config spec C-1).\n\nThe policy only decides whether the agent asks the user before running a tool. It can never auto-approve a tool whose `ToolSpec.requires_approval` is true (weak invariant T1); the only exception is the per-conversation always-allow set owned by the approval spec (S4), which is an explicit earlier user authorization, not a policy decision.",
      "oneOf": [
        {
          "description": "Ask exactly for tools that declare `requires_approval` (default).",
          "type": "string",
          "enum": [
            "ask"
          ]
        },
        {
          "description": "Read-only tools run without asking; every mutating tool asks.",
          "type": "string",
          "enum": [
            "auto_read_only"
          ]
        },
        {
          "description": "Ask for every tool call, including read-only ones (strictest).",
          "type": "string",
          "enum": [
            "strict"
          ]
        }
      ]
    },
    "CompletionSettings": {
      "description": "Sampling / generation parameters for the local agent.",
      "type": "object",
      "properties": {
        "max_tokens": {
          "description": "Output-token cap; omitted keeps the provider default.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "parallel_tool_calls": {
          "description": "Whether the provider may run tool calls in parallel.",
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "prompt_cache": {
          "description": "Prompt-cache retention: `short|long`.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "description": "Portable reasoning effort: `minimal|low|medium|high|xhigh|max`.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "description": "Sampling seed for reproducible runs.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "stop": {
          "description": "Stop sequences.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature": {
          "description": "Sampling temperature (`0.0..=2.0`); omitted keeps the provider default.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "tool_choice": {
          "description": "Tool-selection policy.",
          "default": {
            "mode": "auto"
          },
          "allOf": [
            {
              "$ref": "#/definitions/ToolChoiceSetting"
            }
          ]
        },
        "top_p": {
          "description": "Nucleus sampling (`0.0..=1.0`); omitted keeps the provider default.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "ConnectorTransport": {
      "description": "MCP transport.",
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "EmbeddingSettings": {
      "description": "Personal-edition embedding/vector provider settings (`cap-vector`).\n\nCustom settings are only valid for personal edition: enterprise AI must go through the gateway (C7), and the generated glue never configures a local embedding provider there. `api_key` is write-only in the UI (`settings.get` masks it, like the chat provider key).",
      "type": "object",
      "properties": {
        "api_key": {
          "description": "Bearer key (write-only: masked by `settings.get`).",
          "default": "",
          "type": "string"
        },
        "base_url": {
          "description": "OpenAI-compatible API root, e.g. `https://api.openai.com/v1`.",
          "default": "",
          "type": "string"
        },
        "dims": {
          "description": "Requested vector width (1..=65536), when supported by the endpoint.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 65536.0,
          "minimum": 1.0
        },
        "dir": {
          "description": "Persistence directory for `vector-index.json`; empty = memory-only.",
          "default": "",
          "type": "string"
        },
        "model": {
          "description": "Embedding model id (e.g. `text-embedding-3-small`).",
          "default": "",
          "type": "string"
        }
      }
    },
    "HookSettings": {
      "description": "Observable agent lifecycle hooks configuration.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether lifecycle hook events are emitted.",
          "default": true,
          "type": "boolean"
        },
        "log": {
          "description": "Optional JSONL file that receives the hook events (append-only).",
          "default": "",
          "type": "string"
        }
      }
    },
    "McpServerConfig": {
      "description": "Client-side MCP server configuration (non-secret; ADR-060).\n\nDelivered by the connector catalog / local settings; the client spawns `command` (stdio) or POSTs to `url` (http/sse). Static secrets are rejected by validation (`env` keys must not look like credentials); OAuth tokens stay in the OS keychain.",
      "type": "object",
      "required": [
        "id",
        "name",
        "transport"
      ],
      "properties": {
        "args": {
          "description": "Verbatim argv for stdio (no shell concatenation).",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "Executable for `transport = \"stdio\"` (no shell; args are passed verbatim).",
          "default": "",
          "type": "string"
        },
        "env": {
          "description": "Allow-listed environment for the child process (no static secrets).",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "id": {
          "description": "Connector id (stable, used by tools as `server` argument).",
          "type": "string"
        },
        "name": {
          "description": "Human-readable name.",
          "type": "string"
        },
        "oauth_required": {
          "description": "Whether this server requires an OAuth bearer token (client-side keychain).\n\nSet from the catalog's public-client metadata; the transport injects `Authorization: Bearer <token>` only when a token was installed by the client OAuth flow and fails honestly with `MCP_OAUTH_REQUIRED` otherwise.",
          "default": false,
          "type": "boolean"
        },
        "timeout_ms": {
          "description": "Per-request timeout in milliseconds (0 or absent => default 10s).",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "transport": {
          "description": "Transport.",
          "allOf": [
            {
              "$ref": "#/definitions/ConnectorTransport"
            }
          ]
        },
        "url": {
          "description": "HTTP(S) endpoint for `transport = \"http\"` / `\"sse\"`. Plain `http://` is accepted only for loopback/dev hosts (threat model, docs/07 §6.2); non-loopback requires `https://`.",
          "default": "",
          "type": "string"
        }
      }
    },
    "McpSettings": {
      "description": "Local MCP server settings (personal edition; non-secret config, ADR-060).\n\nThe persisted document only carries non-secret execution config; OAuth tokens stay in the OS keychain and local servers must not require OAuth (they have no authorize/token metadata, so a PKCE flow is impossible — use the enterprise catalog instead).\n\nLimits live **only** here (local settings path): the catalog path keeps the original [`zk_contract_connector::McpServerConfig::validate`] rules, so an already-valid catalog server that exceeds a local cap still works (two-level validation, M-1/R2).",
      "type": "object",
      "properties": {
        "servers": {
          "description": "Locally configured MCP servers (bounded by [`Self::MAX_SERVERS`]).",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/McpServerConfig"
          }
        }
      }
    },
    "MediaSettings": {
      "description": "Personal-edition media capability settings (`cap-image`/`cap-audio`/ `cap-transcription`/`cap-rerank`).\n\nOne OpenAI/Voyage-compatible endpoint and key drive all four kinds; each kind has its own optional model id (empty = the capability's default model). Like [`EmbeddingSettings`], this is personal-edition only (C7): enterprise AI must go through the gateway; the generated glue never configures local providers there.",
      "type": "object",
      "properties": {
        "api_key": {
          "description": "Bearer key shared by the four media kinds (write-only: masked).",
          "default": "",
          "type": "string"
        },
        "audio_model": {
          "description": "Speech-synthesis model id (empty = capability default).",
          "default": "",
          "type": "string"
        },
        "base_url": {
          "description": "OpenAI-compatible API root (empty = each kind's provider default).",
          "default": "",
          "type": "string"
        },
        "image_model": {
          "description": "Image-generation model id (empty = capability default).",
          "default": "",
          "type": "string"
        },
        "rerank_model": {
          "description": "Rerank model id (empty = capability default).",
          "default": "",
          "type": "string"
        },
        "transcription_model": {
          "description": "Transcription model id (empty = capability default).",
          "default": "",
          "type": "string"
        }
      }
    },
    "MemorySettings": {
      "description": "Multi-turn conversation memory for the local agent.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Memory directory; empty means `$ZEOKEEL_HOME/agent-memory`.",
          "default": "",
          "type": "string"
        },
        "enabled": {
          "description": "Whether conversation memory is enabled.",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "ProviderConfig": {
      "description": "Local provider configuration.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "api_key": {
          "description": "API key reference (never the raw key in logs/DB; M1 stores locally).",
          "default": "",
          "type": "string"
        },
        "base_url": {
          "description": "Base URL (required for non-mock).",
          "default": "",
          "type": "string"
        },
        "kind": {
          "description": "Provider kind.",
          "allOf": [
            {
              "$ref": "#/definitions/ProviderKind"
            }
          ]
        },
        "model": {
          "description": "Model name.",
          "default": "",
          "type": "string"
        }
      }
    },
    "ProviderKind": {
      "description": "Provider kind (personal edition local providers).",
      "oneOf": [
        {
          "description": "Deterministic offline mock.",
          "type": "string",
          "enum": [
            "mock"
          ]
        },
        {
          "description": "OpenAI-compatible endpoint (DeepSeek/OpenAI/vLLM...).",
          "type": "string",
          "enum": [
            "open_ai_compatible"
          ]
        },
        {
          "description": "Local Ollama daemon.",
          "type": "string",
          "enum": [
            "ollama"
          ]
        }
      ]
    },
    "ScheduleSettings": {
      "description": "Workspace schedule auto-run settings (`docs/19`/`docs/38`).\n\nAuto-run starts scheduled prompts with no human in the loop, so it is **disabled by default**; the desktop executor always starts but idles while disabled. `scan_seconds` is the poll period for due schedules.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the desktop executes due `.zeokeel/schedules.json` entries.",
          "default": false,
          "type": "boolean"
        },
        "scan_seconds": {
          "description": "Schedule scan period in seconds (`5..=3600`; default 10).",
          "default": 10,
          "type": "integer",
          "format": "uint64",
          "maximum": 3600.0,
          "minimum": 5.0
        }
      }
    },
    "ToolChoiceSetting": {
      "description": "How the model may choose tools for a turn.",
      "oneOf": [
        {
          "description": "The model decides (default).",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          }
        },
        {
          "description": "No tool may be called.",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "description": "At least one tool must be called.",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "required"
              ]
            }
          }
        },
        {
          "description": "Only the listed tools may be called.",
          "type": "object",
          "required": [
            "mode",
            "tools"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "specific"
              ]
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "ToolSettings": {
      "description": "Tool execution and approval-wait timeouts for the local agent.",
      "type": "object",
      "properties": {
        "approval_policy": {
          "description": "Explicit local approval policy (`None` = default `ask`, not published).",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ApprovalPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_timeout_ms": {
          "description": "Approval wait timeout in milliseconds (1000..=1800000).",
          "default": 300000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tool_timeout_ms": {
          "description": "Per-tool-call timeout in milliseconds (1000..=600000).",
          "default": 120000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "WebSearchSettings": {
      "description": "Web-search tool endpoint settings (`tool.web_search`).\n\nThe search tool calls a keyless DuckDuckGo-compatible instant-answer endpoint, so this section carries **no credential**. It is a tool egress endpoint (not an AI provider), therefore C7 does not apply: both editions may point the tool at their own endpoint (C6 weak control). The runtime resolves **explicit settings > `ZEOKEEL_SEARCH_URL` > built-in default** and requires https. `schemars` bounds the timeout so the generated Ajv schema rejects out-of-range values before Rust validation runs (C10).",
      "type": "object",
      "properties": {
        "base_url": {
          "description": "Endpoint base URL (https only); empty = fall back to the env/default.",
          "default": "",
          "type": "string"
        },
        "timeout_ms": {
          "description": "Request timeout in milliseconds (`1000..=120000`; default 15000).",
          "default": 15000,
          "type": "integer",
          "format": "uint64",
          "maximum": 120000.0,
          "minimum": 1000.0
        }
      }
    }
  }
}
