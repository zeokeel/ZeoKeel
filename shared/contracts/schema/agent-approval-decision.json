{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalDecision",
  "description": "Result of an approval request.",
  "oneOf": [
    {
      "description": "Allow exactly this call.",
      "type": "string",
      "enum": [
        "allow_once"
      ]
    },
    {
      "description": "Reject this call.",
      "type": "string",
      "enum": [
        "reject"
      ]
    },
    {
      "description": "Cancel the turn.",
      "type": "string",
      "enum": [
        "cancel"
      ]
    }
  ]
}
