{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connector",
  "description": "Connector definition (no secret/token).",
  "type": "object",
  "required": [
    "auth_mode",
    "enabled",
    "id",
    "name",
    "transport"
  ],
  "properties": {
    "auth_mode": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "scopes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transport": {
      "$ref": "#/definitions/ConnectorTransport"
    }
  },
  "definitions": {
    "ConnectorTransport": {
      "description": "MCP transport.",
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    }
  }
}
