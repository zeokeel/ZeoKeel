{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdjustRequest",
  "description": "Admin adjustment payload.",
  "type": "object",
  "required": [
    "delta_micros",
    "idempotency_key",
    "reason"
  ],
  "properties": {
    "delta_micros": {
      "type": "integer",
      "format": "int64"
    },
    "idempotency_key": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
