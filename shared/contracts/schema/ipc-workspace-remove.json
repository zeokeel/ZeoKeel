{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceRemovePayload",
  "description": "`workspace.remove` payload (destructive; `confirm` must be `true`).",
  "type": "object",
  "required": [
    "confirm",
    "workspace_id"
  ],
  "properties": {
    "confirm": {
      "description": "Explicit user confirmation.",
      "type": "boolean"
    },
    "reassign_to": {
      "description": "Optional target workspace for conversations in the removed one.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "description": "Workspace to remove.",
      "type": "string"
    }
  }
}
