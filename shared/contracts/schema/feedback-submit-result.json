{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeedbackSubmitResult",
  "description": "`feedback.submit` result (local store only).",
  "type": "object",
  "required": [
    "path",
    "stored"
  ],
  "properties": {
    "path": {
      "description": "Absolute path of the written JSON file.",
      "type": "string"
    },
    "stored": {
      "description": "Always `local` (no network submission).",
      "type": "string"
    }
  }
}
