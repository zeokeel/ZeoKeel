{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IpcError",
  "description": "Closed IPC error set.",
  "oneOf": [
    {
      "description": "Command name unknown.",
      "type": "object",
      "required": [
        "UnknownCommand"
      ],
      "properties": {
        "UnknownCommand": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Invalid payload.",
      "type": "object",
      "required": [
        "InvalidPayload"
      ],
      "properties": {
        "InvalidPayload": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Command failed.",
      "type": "object",
      "required": [
        "Failed"
      ],
      "properties": {
        "Failed": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
