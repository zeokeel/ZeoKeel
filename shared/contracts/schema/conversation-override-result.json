{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationOverrideResult",
  "description": "`session.override_get` / `session.override_set` result.",
  "type": "object",
  "required": [
    "overrides"
  ],
  "properties": {
    "overrides": {
      "description": "Effective conversation override after the call.",
      "allOf": [
        {
          "$ref": "#/definitions/ConversationOverride"
        }
      ]
    }
  },
  "definitions": {
    "ConversationOverride": {
      "description": "Conversation-scoped override (model/effort/approval policy).",
      "type": "object",
      "required": [
        "is_session_override"
      ],
      "properties": {
        "approval_policy": {
          "description": "Session approval policy preset.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "is_session_override": {
          "description": "Whether any field is set for this conversation.",
          "type": "boolean"
        },
        "model": {
          "description": "Session model override.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "description": "Session reasoning effort.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
