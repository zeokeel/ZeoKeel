{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workspace",
  "description": "One workspace: a local directory that owns conversations and agent cwd.",
  "type": "object",
  "required": [
    "created_at_ms",
    "id",
    "is_default",
    "path",
    "title",
    "updated_at_ms"
  ],
  "properties": {
    "created_at_ms": {
      "description": "Creation time (ms since epoch).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "id": {
      "description": "Stable id (uuid string).",
      "type": "string"
    },
    "is_default": {
      "description": "Exactly one workspace is the default.",
      "type": "boolean"
    },
    "path": {
      "description": "Canonical local absolute path.",
      "type": "string"
    },
    "title": {
      "description": "Display title.",
      "type": "string"
    },
    "updated_at_ms": {
      "description": "Last update time (ms since epoch).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  }
}
