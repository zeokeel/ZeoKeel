{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerModule",
  "description": "Stable server module descriptor exposed by `srv.*` packages.",
  "type": "object",
  "required": [
    "id",
    "version"
  ],
  "properties": {
    "id": {
      "description": "Namespaced module id (e.g. `srv/http`).",
      "type": "string"
    },
    "version": {
      "description": "Human-readable version.",
      "type": "string"
    }
  }
}
