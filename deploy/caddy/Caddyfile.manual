# TLS_MODE=manual — customer-supplied certificate; no ACME.
# Put fullchain.pem / privkey.pem under deploy/caddy/certs/ (mounted read-only at
# /etc/caddy/certs). entrypoint.sh refuses to start if either file is missing.
{$DOMAIN} {
	encode zstd gzip
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	handle /admin/* {
		reverse_proxy server:8787
	}
	handle /api/* {
		reverse_proxy server:8787
	}
	handle /v1/* {
		reverse_proxy server:8787
	}
	handle /portal* {
		reverse_proxy server:8787
	}
	handle /healthz {
		reverse_proxy server:8787
	}
	handle /readyz {
		reverse_proxy server:8787
	}
	handle {
		root * /srv/portal
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
