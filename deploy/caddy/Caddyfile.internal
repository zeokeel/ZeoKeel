# TLS_MODE=internal — Caddy internal CA; intended for offline/intranet deployments and
# drill runs. Clients must trust the internal CA or run with -k (documented limitation).
{$DOMAIN} {
	encode zstd gzip
	tls internal
	handle /admin/* {
		reverse_proxy server:8787
	}
	handle /api/* {
		reverse_proxy server:8787
	}
	handle /v1/* {
		reverse_proxy server:8787
	}
	handle /portal* {
		reverse_proxy server:8787
	}
	handle /healthz {
		reverse_proxy server:8787
	}
	handle /readyz {
		reverse_proxy server:8787
	}
	handle {
		root * /srv/portal
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
