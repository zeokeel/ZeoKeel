# Six required keys (docs/06 §5 / docs/09). Keep 0600; never commit values.
DOMAIN=zeokeel.example.com
TLS_MODE=auto
ADMIN_PASSWORD=change-me-min-12
PG_PASSWORD=change-me-strong
SERVER_IMAGE=zeokeel/server:0.1.0
MASTER_KEY=base64-32-bytes-generated-offline
# Optional upstream gateway (server-side only)
UPSTREAM_BASE_URL=https://api.example.com/v1
UPSTREAM_API_KEY=
