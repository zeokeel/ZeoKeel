# deploy/.env — 6 required keys (docs/06 §5 / docs/09 §5). chmod 600; never commit values.
# Note: docs/09 §5 marks MASTER_KEY "recommended"; docs/06 §5 and deploy/docker-compose.yml
# treat it as required so a deployment cannot run without the key it encrypts with.
DOMAIN=zeokeel.example.com
TLS_MODE=auto                     # auto | manual | internal (selects deploy/caddy/Caddyfile.*)
ADMIN_PASSWORD=change-me-min-12
PG_PASSWORD=change-me-strong
SERVER_IMAGE=zeokeel/server:0.1.0-official
MASTER_KEY=base64-32-bytes-generated-offline

# Optional: upstream OpenAI-compatible gateway (kept server-side only, ADR-031)
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# Optional operational knobs (defaults shown; docs/20 §5). Retention floors are enforced
# in code (audit >=180d, usage >=365d).
ADMIN_USERNAME=admin
COOKIE_SECURE=1
AUDIT_RETENTION_DAYS=180
USAGE_RETENTION_DAYS=365
MONTHLY_GRANT_MICROS=0
MONTHLY_GRANT_MODE=accumulate
